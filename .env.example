# =============================================================================
# Copy to .env and fill in. Nothing in this file is committed.
#
# Three audiences read these variables:
#   [browser]  stamped into frontend/js/config.js at deploy time — public
#   [edge]     Supabase function secrets — `supabase secrets set`
#   [python]   the cron host's environment or python/.env
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# [browser] [edge] [python]  Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# [browser]  Anon key. Public by design; RLS is what protects the data.
SUPABASE_ANON_KEY=
# [edge] [python]  Service role key. Bypasses RLS. Never ships to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# [python]  Direct Postgres connection (Settings -> Database -> Connection string).
# Use the pooler (port 6543) for cron jobs.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Google -----------------------------------------------------------------
# [browser]  Maps JS + Places Autocomplete. Restrict to your Pages domain by
# HTTP referrer, and enable only: Maps JavaScript API, Places API (New).
GOOGLE_MAPS_BROWSER_KEY=
# [edge]  Server-side Places key. Restrict by IP if you can; never expose it.
GOOGLE_PLACES_API_KEY=

# --- Resend -----------------------------------------------------------------
# [edge] [python]
RESEND_API_KEY=
# Must be on a domain verified in Resend, or delivery will fail.
RESEND_FROM="Hyderabad Property Map <notify@yourdomain.com>"
# Where owner replies land. This mailbox is what email_processor.py polls.
REPLY_TO_ADDRESS=replies@yourdomain.com

# --- Razorpay ---------------------------------------------------------------
# [browser]  Publishable half of the key pair.
RAZORPAY_KEY_ID=
# [edge]  Secret half. Server only.
RAZORPAY_KEY_SECRET=
# [edge]  From the Razorpay dashboard webhook you create for this endpoint.
RAZORPAY_WEBHOOK_SECRET=
# [browser] [edge]  Master switch for the ₹1 flow. "false" hides the toggle
# and makes create_razorpay_order refuse.
PAYMENTS_ENABLED=true
# [edge]  Amount in paise. 100 = ₹1.
INTEREST_AMOUNT_PAISE=100

# --- Email intake (python) --------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_USER=replies@yourdomain.com
# Gmail: an App Password, not the account password.
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Misc -------------------------------------------------------------------
# [edge] [python]  Public site URL, used in email links.
SITE_URL=https://hyd-map.pages.dev
# [edge]  Comma-separated CORS allowlist. "*" only for local development.
ALLOWED_ORIGINS=https://hyd-map.pages.dev
# [edge]  AQI overlay (free token from aqicn.org/data-platform/token).
WAQI_TOKEN=
# [python]  Set true to log every email instead of sending it.
DRY_RUN=false
LOG_LEVEL=INFO
