# Cloudflare Pages headers.
#
# No fingerprinting: this project has no build step, so every JS/CSS file
# keeps the same fixed name across every deploy forever (frontend/js/map.js
# is always frontend/js/map.js — nothing hashes it to frontend/js/map.a3f8e1.js
# the way a bundler output would). `immutable, max-age=31536000` is only safe
# when a *new* version gets a *new* URL; here it just means a browser that
# visited once keeps serving year-old JavaScript no matter how many times the
# site redeploys after that. must-revalidate makes every load check back with
# the server (a cheap 304 when nothing changed, the real bytes the moment
# something did) instead of trusting a TTL that has no way to know the file
# underneath it changed.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' https://maps.googleapis.com https://checkout.razorpay.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.supabase.co; connect-src 'self' https://*.supabase.co https://maps.googleapis.com https://places.googleapis.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Same reasoning as /js/* and /css/* above, and today's proof it isn't just
# theoretical: transit.json changed (metro line simplification) and the old
# 1-day cache here meant it wouldn't have shown up live for up to 24h. This
# file is fetched once per session, not per-viewport, so must-revalidate's
# conditional-GET cost is trivial next to guaranteed staleness.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
